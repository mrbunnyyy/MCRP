# Required
DISCORD_TOKEN=your_discord_bot_token_here

# Optional but recommended on Railway for durable persistence
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# HTTP health server
PORT=3000
WEB_HOST=0.0.0.0

# Prefix command
COMMAND_PREFIX=!

# Staff authorization (comma-separated Discord role IDs)
# Staff can use: !bgbb sr send
BGBB_STAFF_ROLE_IDS=

# Admin authorization (comma-separated Discord role IDs)
# Admins can use: !bgbbedit
BGBB_ADMIN_ROLE_IDS=

# Local fallback storage. This survives normal process restarts.
BGBB_DATA_FILE=./data/bgbb.json
